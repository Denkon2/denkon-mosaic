{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "primary", "color": "#9a681d", "name": "Золотой Denkon" },
        { "slug": "ink", "color": "#282522", "name": "Графит" },
        { "slug": "muted", "color": "#6d665d", "name": "Приглушённый" },
        { "slug": "surface", "color": "#ffffff", "name": "Поверхность" },
        { "slug": "canvas", "color": "#f8f6f2", "name": "Фон" },
        { "slug": "transparent", "color": "transparent", "name": "Прозрачный" }
      ]
    },
    "layout": {
      "contentSize": "98%",
      "wideSize": "98%",
      "allowEditing": true
    },
    "spacing": {
      "blockGap": true,
      "units": [ "px", "rem", "%", "vw" ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "slug": "system", "name": "Системный" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Маленький" },
        { "slug": "medium", "size": "1.125rem", "name": "Средний" },
        { "slug": "large", "size": "clamp(1.5rem, 2.5vw, 2.5rem)", "name": "Большой" },
        { "slug": "x-large", "size": "clamp(2.25rem, 5vw, 4.5rem)", "name": "Очень большой" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--canvas)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system)", "lineHeight": "1.6" },
    "elements": {
      "button": { "border": { "radius": "8px" }, "color": { "background": "var(--wp--preset--color--primary)", "text": "#ffffff" }, "spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.2rem", "right": "1.2rem" } } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } }
    }
  }
}
